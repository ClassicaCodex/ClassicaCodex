<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClassicaCodex.Tools.CatmusCatalogue</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Never part of a release. This rebuilds a file that ships inside the
         application; running it is a deliberate act by whoever is updating
         to a newer CATMuS release, not something an installation does. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassicaCodex.Ingestion\ClassicaCodex.Ingestion.csproj" />
  </ItemGroup>

</Project>
