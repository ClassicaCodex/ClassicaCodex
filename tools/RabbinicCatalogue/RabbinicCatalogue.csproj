<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClassicaCodex.Tools.RabbinicCatalogue</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Never part of a release: it rebuilds a file that ships inside the
         application, and running it is a deliberate act by whoever is
         deciding which versions the rabbinic step takes. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassicaCodex.Ingestion\ClassicaCodex.Ingestion.csproj" />
  </ItemGroup>

</Project>
