<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClassicaCodex.Tools.CatmusManifests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Never part of a release, for the same reason as CatmusCatalogue: it
         rebuilds a file that ships inside the application, and running it is a
         deliberate act by whoever is updating that file. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassicaCodex.Ingestion\ClassicaCodex.Ingestion.csproj" />
  </ItemGroup>

</Project>
