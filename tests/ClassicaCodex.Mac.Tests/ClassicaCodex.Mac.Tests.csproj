<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <AvaloniaBuildTelemetry>false</AvaloniaBuildTelemetry>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClassicaCodex.Mac\ClassicaCodex.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows app's own class, so that the test of the key file is
         against what that app really reads and writes and not against a copy
         of its format. It calls DPAPI with no guard, being a Windows project,
         and the test only reaches it on Windows. Hence CA1416. -->
    <Compile Include="..\..\src\ClassicaCodex.UI\TranslationSettings.cs" Link="Classic\TranslationSettings.cs" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
