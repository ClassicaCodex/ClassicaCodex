<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the hardened runtime has to allow for the app to run at all, and
  nothing else. Notarisation requires the hardened runtime, and the hardened
  runtime forbids writing code into memory and then running it - which is
  what .NET's JIT compiler does with every method it compiles. Without these
  the app is killed the moment it starts.

  Nothing else is asked for: the Keychain, `say`, `open` and `afplay` are all
  allowed to a hardened app as it stands.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
