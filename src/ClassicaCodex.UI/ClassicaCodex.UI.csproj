<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <Version>3.6.11</Version>
    <AssemblyVersion>3.6.11.0</AssemblyVersion>
    <FileVersion>3.6.11.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClassicaCodex.UI</RootNamespace>
    <!-- Enables the compiler's structural checks on /// doc comments -
         specifically CS1587 ("XML comment is not placed on a valid language
         element"), which is exactly what would have caught the nine
         orphaned/misattached doc-comment blocks found in the first review
         pass of this codebase, automatically, on every future build.
         CS1591 ("missing XML comment for publicly visible member") is
         suppressed: this project documents public members selectively, not
         universally, so demanding one on every public method would flood
         the build with thousands of warnings unrelated to the actual
         problem this is here to catch.
         CS1573 ("parameter has no matching param tag, but other parameters
         do") is suppressed for the same reason one level down: a comment
         here explains the parameters that need explaining and leaves the
         obvious ones alone. Satisfying it would mean a tag for every
         cancellationToken in the codebase - noise that would bury the
         structural warnings above, which are the ones worth reading. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the export writers can be tested. They are internal because
         nothing outside this assembly calls them, not because their
         behaviour is uninteresting - and what they put in a cell is very
         interesting indeed to anyone who opens the file afterwards. -->
    <InternalsVisibleTo Include="ClassicaCodex.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicaCodex.Core\ClassicaCodex.Core.csproj" />
    <ProjectReference Include="..\ClassicaCodex.Data\ClassicaCodex.Data.csproj" />
    <ProjectReference Include="..\ClassicaCodex.Ingestion\ClassicaCodex.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <!-- Windows' own offline speech synthesis (SAPI) - Read Aloud's only
         mechanism for now. No network, no API key, no cost: it just asks
         whatever voice is already installed on the machine to speak. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- DPAPI (ProtectedData) isn't in the .NET 8 base library the way it was
         in .NET Framework - it ships separately. Used only by
         TranslationSettings, to keep API keys off disk in plaintext. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The download is a binary-only ZIP, and that is a copy of the software
         in the sense MIT means: the licence and its copyright notice have to
         travel with it. Until 3.6.7 they did not - the ZIP held the executable
         and the Icons folder and nothing else, while the repository carried a
         LICENSE nobody downloading ever saw.

         Also carried because the bundle contains other people's code with its
         own conditions - SQLitePCLRaw is Apache-2.0, whose section 4(a) wants
         recipients given a copy of that licence, and libgit2 is GPLv2 with a
         linking exception.

         Declared here rather than copied in at packaging time so that a
         release cannot be cut without them: the publish output is the thing
         that gets zipped, and this puts them in it. LICENSE is linked with a
         .txt extension because it has no extension of its own, and Windows
         will not open it by double-click without one. -->
    <Content Include="..\..\LICENSE" Link="LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- The runtime's own notices, carried verbatim from the runtime pack.
         A self-contained build bundles the .NET runtime, and the runtime
         bundles other people's code in turn - zlib and Brotli among them,
         statically linked into the executable rather than shipped as separate
         files, which is why no System.IO.Compression.Native.dll appears in the
         download. Several of this file's forty-four sections are BSD-family
         notices whose terms ask that they be reproduced in binary
         redistributions. Ours is not the only notice file that has to travel
         with the download. -->
    <Content Include="..\..\THIRD-PARTY-NOTICES-DOTNET.txt" Link="THIRD-PARTY-NOTICES-DOTNET.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <!-- libgit2's own licence file, verbatim from its package: the GPLv2
         text, the linking exception that permits this use, and the notices
         for the PCRE2, zlib and xdiff code vendored inside git2-5853918.dll.

         libgit2 is the one copyleft component in the bundle, and GPLv2
         section 1 asks that a copy of the licence travel with the program.
         Up to 3.6.10 this download reproduced MIT and Apache-2.0 in full and
         the GPL not at all - the permissive licences that ask least were
         honoured, and the only one that asks something was not. -->
    <Content Include="..\..\THIRD-PARTY-NOTICES-LIBGIT2.txt" Link="THIRD-PARTY-NOTICES-LIBGIT2.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    PDFsharp ships PdfSharp.WPFonts.dll, and that assembly embeds six Microsoft
    Segoe WP typefaces. Their own name tables read "Microsoft Corporation. All
    Rights Reserved." and "You may use this font as permitted by the EULA for
    the product in which this font is included" - the product being the Windows
    Phone SDK, not this one. empira's MIT grant covers PDFsharp's code; it
    cannot relicense Microsoft's typefaces, so every release up to 3.6.8
    redistributed proprietary fonts under a notice claiming they were MIT.

    Nothing here uses them. This application draws PDFs through PdfSharp.dll
    with its own WindowsFontResolver, so the fonts and the sample resolver that
    references them are dead weight with a licence attached.

    PdfSharp.Snippets and PdfSharp.Quality go with it. Both are PDFsharp's own
    sample and benchmark scaffolding, neither is referenced from anywhere in
    this solution, and between them they hold every reference to WPFonts -
    removing the fonts while leaving an assembly that loads them is how a
    FileNotFoundException turns up later, in the one code path nobody tested.

    Quality was missed when 3.6.9 removed the other two, so 3.6.9 shipped it
    carrying a reference to an assembly no longer in the bundle. Nothing
    reaches it - PdfSharp.dll itself references only PdfSharp.Shared and
    PdfSharp.System, so the loader never has cause to resolve Quality - but
    "unreachable" is what was said about two checks that turned out not to
    work, and a dangling reference is not something to leave in a shipped
    binary on that basis.
  -->
  <Target Name="ExcludeProprietaryFonts"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_ComputeFilesToBundle">
    <!--
      Gathered into a list first, then removed by that list. A Remove with a
      metadata Condition on the item being removed does not batch the way it
      reads: written that way this target ran, reported nothing, and left both
      assemblies in the bundle. An Include with a Condition does batch over
      metadata, so the two-step form is the one that actually works.

      BeforeTargets is _ComputeFilesToBundle, not GenerateSingleFileBundle.
      _ComputeFilesToBundle MOVES items - it copies ResolvedFileToPublish into
      _FilesToBundle and then empties it - and it is a dependency of
      GenerateSingleFileBundle, so it has already run by the time anything
      "before" that target fires. Hooked there, this target reported both
      assemblies excluded and both shipped anyway.
    -->
    <ItemGroup>
      <_ProprietaryAssemblies Include="@(ResolvedFileToPublish)"
                              Condition="'%(Filename)' == 'PdfSharp.WPFonts'
                                      Or '%(Filename)' == 'PdfSharp.Snippets'
                                      Or '%(Filename)' == 'PdfSharp.Quality'" />
      <ResolvedFileToPublish Remove="@(_ProprietaryAssemblies)" />
      <ReferenceCopyLocalPaths Remove="@(_ProprietaryAssemblies)" />
    </ItemGroup>

    <Error Condition="'@(_ProprietaryAssemblies)' == ''"
           Text="ExcludeProprietaryFonts matched nothing. Either PDFsharp stopped shipping PdfSharp.WPFonts, or it renamed it - check before assuming the fonts are gone." />

    <Message Importance="high" Text="Excluded from the bundle: @(_ProprietaryAssemblies->'%(Filename)%(Extension)', ', ')" />
  </Target>

  <ItemGroup>
    <!-- Shipped beside the executable; AppIcons loads them at runtime and
         degrades to text-only buttons if the folder is missing. -->
    <None Include="Icons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icons\BronzeAndThunder.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeAndThunder.ico" />
    <EmbeddedResource Include="Icons\BronzeBestiary.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeBestiary.ico" />
    <EmbeddedResource Include="Icons\BronzeDivineGift.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeDivineGift.ico" />
    <EmbeddedResource Include="Icons\BronzeLaurels.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeLaurels.ico" />
    <EmbeddedResource Include="Icons\BronzeJournal.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeJournal.ico" />
    <EmbeddedResource Include="Icons\BronzeNewAdventure.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeNewAdventure.ico" />
    <EmbeddedResource Include="Icons\BronzeBeginAdventure.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeBeginAdventure.ico" />
    <EmbeddedResource Include="Icons\BronzeSoundOn.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeSoundOn.ico" />
    <EmbeddedResource Include="Icons\BronzeSoundOff.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeSoundOff.ico" />
    <EmbeddedResource Include="Icons\BronzeOracleHint.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeOracleHint.ico" />
    <EmbeddedResource Include="Icons\BronzeCheckPassage.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeCheckPassage.ico" />
    <EmbeddedResource Include="Icons\BronzeRevealCitation.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeRevealCitation.ico" />
    <EmbeddedResource Include="Icons\BronzeHighlightPassage.ico" LogicalName="ClassicaCodex.UI.Icons.BronzeHighlightPassage.ico" />
  </ItemGroup>
</Project>
