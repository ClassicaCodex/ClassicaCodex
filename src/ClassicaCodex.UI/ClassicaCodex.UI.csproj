<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <Version>3.4.0</Version>
    <AssemblyVersion>3.4.0.0</AssemblyVersion>
    <FileVersion>3.4.0.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClassicaCodex.UI</RootNamespace>
    <!-- Enables the compiler's structural checks on /// doc comments -
         specifically CS1587 ("XML comment is not placed on a valid language
         element"), which is exactly what would have caught the nine
         orphaned/misattached doc-comment blocks found in the first review
         pass of this codebase, automatically, on every future build.
         CS1591 ("missing XML comment for publicly visible member") is
         suppressed: this project documents public members selectively, not
         universally, so demanding one on every public method would flood
         the build with thousands of warnings unrelated to the actual
         problem this is here to catch.
         CS1573 ("parameter has no matching param tag, but other parameters
         do") is suppressed for the same reason one level down: a comment
         here explains the parameters that need explaining and leaves the
         obvious ones alone. Satisfying it would mean a tag for every
         cancellationToken in the codebase - noise that would bury the
         structural warnings above, which are the ones worth reading. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClassicaCodex.Core\ClassicaCodex.Core.csproj" />
    <ProjectReference Include="..\ClassicaCodex.Data\ClassicaCodex.Data.csproj" />
    <ProjectReference Include="..\ClassicaCodex.Ingestion\ClassicaCodex.Ingestion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="PdfSharp" Version="6.2.4" />
    <!-- Windows' own offline speech synthesis (SAPI) - Read Aloud's only
         mechanism for now. No network, no API key, no cost: it just asks
         whatever voice is already installed on the machine to speak. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- DPAPI (ProtectedData) isn't in the .NET 8 base library the way it was
         in .NET Framework - it ships separately. Used only by
         TranslationSettings, to keep API keys off disk in plaintext. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped beside the executable; AppIcons loads them at runtime and
         degrades to text-only buttons if the folder is missing. -->
    <None Include="Icons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
